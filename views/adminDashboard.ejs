<!DOCTYPE html>
<html>
<head>
    <title>MMU Parking Dashboard</title>
    <style>
        body { font-family: 'Segoe UI', sans-serif; background-color: #f4f6f8; text-align: center; }
        h1 { color: #1a237e; }
        table { margin: 20px auto; width: 90%; border-collapse: collapse; background: white; box-shadow: 0 4px 8px rgba(0,0,0,0.1); }
        th, td { padding: 12px; border-bottom: 1px solid #ddd; }
        th { background-color: #1a237e; color: white; }

        /* Modal Styles — flex-centered & scroll-on-overflow so it stays in viewport at any zoom */
        .modal {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.5);
            justify-content: center;
            align-items: center;
            padding: 16px;
            box-sizing: border-box;
            overflow-y: auto;
        }
        .modal.open { display: flex; }
        .modal-content {
            background: white;
            padding: 18px 20px;
            width: 100%;
            max-width: 380px;
            max-height: calc(100vh - 32px);
            overflow-y: auto;
            border-radius: 8px;
            text-align: left;
            box-shadow: 0 8px 24px rgba(0,0,0,0.2);
        }
        .modal-content h2 { margin: 0 0 10px 0; font-size: 1.15rem; }
        .modal-content label { display: block; font-size: 0.85rem; margin-top: 6px; color: #444; }
        .btn-add { position: absolute; top: 20px; right: 20px; padding: 10px 20px; background: #28a745; color: white; text-decoration: none; border-radius: 5px; cursor: pointer; }
        input { width: 100%; padding: 6px 8px; margin: 2px 0 6px 0; display: inline-block; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box; font-size: 0.9rem; }
        .btn-submit { background-color: #1a237e; color: white; padding: 8px 12px; border: none; border-radius: 4px; cursor: pointer; width: 100%; font-size: 0.9rem; }
        .close { float: right; font-size: 24px; font-weight: bold; cursor: pointer; line-height: 1; }
        #statusMsg { margin: 8px 0 0 0; font-size: 0.85rem; min-height: 1em; }

        @media (max-width: 480px) {
            .modal-content { max-width: 100%; padding: 14px; }
            .btn-add { top: 10px; right: 10px; padding: 8px 14px; font-size: 0.9rem; }
        }
    </style>
</head>
<body>
    <h1>🚗 MMU Parking Admin Dashboard</h1>
    <div id="readerStatus" style="margin-bottom: 12px; font-size: 0.95rem; color:#333;">
        Reader Status: <span id="readerStatusValue">Checking...</span>
    </div>
    
    <a onclick="openModal()" class="btn-add">+ Register User</a>

    <table id="parkingTable">
        <tr>
            <th>MMU ID</th>
            <th>User Name</th>
            <th>Car Plate</th>
            <th>Check In</th>
            <th>Check Out</th>
            <th>Duration</th>
        </tr>
        <% logs.forEach(log => { %>
            <tr>
                <td><%= log.mmu_id %></td>
                <td><%= log.name %></td>
                <td><%= log.car_plate %></td>
                <td><%= new Date(log.check_in).toLocaleString() %></td>
                <td><%= log.check_out ? new Date(log.check_out).toLocaleString() : 'Parked' %></td>
                <td>
                    <% 
                        if(log.check_out) {
                            const diff = new Date(log.check_out) - new Date(log.check_in);
                            const mins = Math.floor(diff / 60000);
                            %><%= Math.floor(mins/60) %>h <%= mins%60 %>m<%
                        } else { %> - <% } 
                    %>
                </td>
            </tr>
        <% }) %>
    </table>

    <div id="addModal" class="modal">
        <div class="modal-content">
            <span onclick="closeModal()" class="close">&times;</span>
            <h2>Register New User</h2>
            <form id="registerForm">
                <label>MMU ID</label>
                <input type="text" id="mmu_id" required placeholder="e.g. 11223344">

                <label>Full Name</label>
                <input type="text" id="name" required placeholder="e.g. Ali bin Abu">

                <label>Car Plate</label>
                <input type="text" id="car_plate" required placeholder="e.g. WWA 1234">

                <label>Card/Tag UID (Scan Card/Tag to Auto-Fill)</label>
                <input type="text" id="card_uid" readonly placeholder="Waiting for scan...">
                <button type="button" id="scanButton" class="btn-submit" style="margin-bottom: 10px;">📡 Manual Scan</button>
                <button type="button" id="saveBtn" class="btn-submit" disabled style="opacity: 0.5; background-color:#28a745;">💾 Save Data</button>
            </form>
            <p id="statusMsg" style="color: blue; text-align: center; margin-top: 10px;"></p>
        </div>
    </div>

    <script>
        let scanInterval;
        let statusPollInterval;
        const READER_API = 'http://localhost:4000';

        function setReaderStatus(connected) {
            const statusValue = document.getElementById('readerStatusValue');
            if (connected) {
                statusValue.textContent = 'Connected';
                statusValue.style.color = '#2e7d32';
            } else {
                statusValue.textContent = 'Disconnected';
                statusValue.style.color = '#c62828';
            }
        }

        async function fetchReaderStatus() {
            try {
                const response = await fetch(`${READER_API}/status`);
                console.log('Status response:', response.status);
                if (!response.ok) throw new Error('Status fetch failed');
                const data = await response.json();
                console.log('Reader status data:', data);
                setReaderStatus(Boolean(data.connected));
                return Boolean(data.connected);
            } catch (err) {
                console.error('Reader status fetch error:', err);
                setReaderStatus(false);
                return false;
            }
        }

        async function fetchLastScan() {
            try {
                const response = await fetch(`${READER_API}/last-scan`);
                if (!response.ok) throw new Error('Scan fetch failed');
                const data = await response.json();
                console.log('Last scan data:', data);
                return data.uid || '';
            } catch (err) {
                console.error('Last scan fetch error:', err);
                return '';
            }
        }

        function setSaveEnabled(enabled) {
            const b = document.getElementById('saveBtn');
            b.disabled = !enabled;
            b.style.opacity = enabled ? '1' : '0.5';
        }

        async function openModal() {
            document.getElementById('addModal').classList.add('open');
            document.getElementById('card_uid').value = '';
            document.getElementById('statusMsg').innerText = 'Please place a new card/tag on the reader...';
            document.getElementById('statusMsg').style.color = 'blue';
            setSaveEnabled(false);
            entryPollEnabled = false; // pause toll-gate polling while registering

            await fetchReaderStatus();
            scanInterval = setInterval(async () => {
                const cardUid = await fetchLastScan();
                if (cardUid) {
                    document.getElementById('card_uid').value = cardUid;
                    document.getElementById('statusMsg').innerText = '✅ Card detected! Fill in the user info and Save.';
                    document.getElementById('statusMsg').style.color = 'green';
                    setSaveEnabled(true);
                }
            }, 1000);
        }

        function closeModal() {
            document.getElementById('addModal').classList.remove('open');
            clearInterval(scanInterval);
            entryPollEnabled = true; // resume toll-gate polling
        }

        document.getElementById('scanButton').addEventListener('click', async () => {
            const cardUid = await fetchLastScan();
            const status = document.getElementById('statusMsg');
            if (cardUid) {
                document.getElementById('card_uid').value = cardUid;
                status.style.color = 'green';
                status.innerText = '✅ Tag read successfully.';
                setSaveEnabled(true);
            } else {
                status.style.color = 'blue';
                status.innerText = '🔍 Triggering manual scan...';
                try {
                    await fetch(`${READER_API}/scan`);
                    await new Promise(resolve => setTimeout(resolve, 1000));
                    const manualCardUid = await fetchLastScan();
                    if (manualCardUid) {
                        document.getElementById('card_uid').value = manualCardUid;
                        status.style.color = 'green';
                        status.innerText = '✅ Tag read successfully via manual scan.';
                        setSaveEnabled(true);
                    } else {
                        status.style.color = 'red';
                        status.innerText = 'No tag detected. Try repositioning the tag closer to the reader.';
                    }
                } catch (err) {
                    status.style.color = 'red';
                    status.innerText = 'Manual scan failed. Check reader connection.';
                }
            }
        });

        function getFormFields() {
            return {
                mmu_id:    document.getElementById('mmu_id').value.trim(),
                name:      document.getElementById('name').value.trim(),
                car_plate: document.getElementById('car_plate').value.trim(),
                card_uid:  document.getElementById('card_uid').value.trim(),
            };
        }

        document.getElementById('saveBtn').addEventListener('click', async () => {
            const status = document.getElementById('statusMsg');
            const { mmu_id, name, car_plate, card_uid } = getFormFields();
            if (!card_uid) { alert('Place a card/tag on the reader first!'); return; }
            if (!mmu_id || !name || !car_plate) { alert('Fill MMU ID, Name and Car Plate first!'); return; }

            status.style.color = 'blue';
            status.innerText = '💾 Saving to database...';
            try {
                const res = await fetch('/api/register', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ mmu_id, name, car_plate, card_uid })
                });
                if (res.ok) {
                    clearInterval(scanInterval);
                    alert('✅ User saved to database.');
                    location.reload();
                } else {
                    const txt = await res.text();
                    status.style.color = 'red';
                    status.innerText = '❌ Save failed: ' + txt;
                }
            } catch (err) {
                status.style.color = 'red';
                status.innerText = '❌ Server unreachable: ' + err.message;
            }
        });

        async function startStatusPoll() {
            await fetchReaderStatus();
            statusPollInterval = setInterval(fetchReaderStatus, 3000);
        }

        // ---- Toll-gate entry poller ----
        // Tap tag -> /api/entry toggles check-in / check-out.
        // Debounced server-side, so we don't need to worry about a tag bouncing.
        let entryPollEnabled = true;

        async function pollEntry() {
            if (!entryPollEnabled) return;
            const uid = await fetchLastScan();
            if (!uid) return;
            try {
                const r = await fetch(`/api/entry?card=${encodeURIComponent(uid)}`);
                const msg = await r.text();
                console.log('Entry result:', msg);
            } catch (err) {
                console.error('Entry call failed:', err);
            }
        }

        // ---- Count-change watcher ----
        // Reloads the table whenever the DB-level occupancy changes — works
        // regardless of which page (kiosk or dashboard) actually drove the tap.
        // Baseline is the count at server-render time (not at first poll), so
        // any tap between page-render and the first poll still triggers a reload.
        let lastKnownOccupied = <%= occupiedAtRender %>;
        async function pollCount() {
            if (!entryPollEnabled) return; // pause during registration modal
            try {
                const r = await fetch('/api/parking-count');
                const data = await r.json();
                if (data.occupied !== lastKnownOccupied) {
                    location.reload();
                }
            } catch (err) {
                console.error('Count poll failed:', err);
            }
        }

        startStatusPoll();
        setInterval(pollEntry, 1000);
        setInterval(pollCount, 1500);
    </script>
</body>
</html>