<!DOCTYPE html>
<html>
<head>
    <title>MMU Parking Dashboard</title>
    <style>
        body { font-family: 'Segoe UI', sans-serif; background-color: #f4f6f8; text-align: center; }
        h1 { color: #1a237e; }
        table { margin: 20px auto; width: 90%; border-collapse: collapse; background: white; box-shadow: 0 4px 8px rgba(0,0,0,0.1); }
        th, td { padding: 12px; border-bottom: 1px solid #ddd; }
        th { background-color: #1a237e; color: white; }
        
        /* Modal Styles */
        .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); }
        .modal-content { background: white; margin: 10% auto; padding: 20px; width: 400px; border-radius: 8px; text-align: left;}
        .btn-add { position: absolute; top: 20px; right: 20px; padding: 10px 20px; background: #28a745; color: white; text-decoration: none; border-radius: 5px; cursor: pointer; }
        input { width: 100%; padding: 8px; margin: 5px 0 15px 0; display: inline-block; border: 1px solid #ccc; box-sizing: border-box; }
        .btn-submit { background-color: #1a237e; color: white; padding: 10px 15px; border: none; cursor: pointer; width: 100%; }
        .close { float: right; font-size: 28px; font-weight: bold; cursor: pointer; }
    </style>
</head>
<body>
    <h1>🚗 MMU Parking Admin Dashboard</h1>
    
    <a onclick="document.getElementById('addModal').style.display='block'" class="btn-add">+ Register User</a>

    <table id="parkingTable">
        <tr>
            <th>MMU ID</th>
            <th>User Name</th>
            <th>Car Plate</th>
            <th>Check In</th>
            <th>Check Out</th>
            <th>Duration</th>
        </tr>
        <% logs.forEach(log => { %>
            <tr>
                <td><%= log.mmu_id %></td>
                <td><%= log.name %></td>
                <td><%= log.car_plate %></td>
                <td><%= new Date(log.check_in).toLocaleString() %></td>
                <td><%= log.check_out ? new Date(log.check_out).toLocaleString() : 'Parked' %></td>
                <td>
                    <% 
                        if(log.check_out) {
                            const diff = new Date(log.check_out) - new Date(log.check_in);
                            const mins = Math.floor(diff / 60000);
                            %><%= Math.floor(mins/60) %>h <%= mins%60 %>m<%
                        } else { %> - <% } 
                    %>
                </td>
            </tr>
        <% }) %>
    </table>

    <div id="addModal" class="modal">
        <div class="modal-content">
            <span onclick="document.getElementById('addModal').style.display='none'" class="close">&times;</span>
            <h2>Register New User</h2>
            <form id="registerForm">
                <label>MMU ID</label>
                <input type="text" id="mmu_id" required placeholder="e.g. 11223344">

                <label>Full Name</label>
                <input type="text" id="name" required placeholder="e.g. Ali bin Abu">

                <label>Car Plate</label>
                <input type="text" id="car_plate" required placeholder="e.g. WWA 1234">

                <label>Card UID (Scan Card to Auto-fill)</label>
                <input type="text" id="card_uid" readonly placeholder="Waiting for scan...">

                <button type="submit" class="btn-submit">💾 Write to Card & Save</button>
            </form>
            <p id="statusMsg" style="color: blue; text-align: center; margin-top: 10px;"></p>
        </div>
    </div>

    <script>
        let scanInterval;

        // Opens modal and starts listening for a card scan
        function openModal() {
            document.getElementById('addModal').style.display='block';
            document.getElementById('card_uid').value = '';
            document.getElementById('statusMsg').innerText = 'Please place a new card on the reader...';
            document.getElementById('submitBtn').disabled = true;
            document.getElementById('submitBtn').style.opacity = '0.5';

            scanInterval = setInterval(async () => {
                try {
                    const response = await fetch('http://localhost:4000/last-scan');
                    const data = await response.json();
                    
                    if (data.uid) {
                        document.getElementById('card_uid').value = data.uid;
                        document.getElementById('statusMsg').innerText = '✅ Card detected! You may now save.';
                        document.getElementById('statusMsg').style.color = 'green';
                        
                        // Enable the submit button once a card is detected
                        document.getElementById('submitBtn').disabled = false;
                        document.getElementById('submitBtn').style.opacity = '1';
                    }
                } catch (e) {
                    console.log("Waiting for reader...");
                }
            }, 1000); // Check every 1 second
        }

        // Closes modal and stops listening
        function closeModal() {
            document.getElementById('addModal').style.display='none';
            clearInterval(scanInterval);
        }

        document.getElementById('registerForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            
            // Stop scanning while we write
            clearInterval(scanInterval); 

            const status = document.getElementById('statusMsg');
            const mmuId = document.getElementById('mmu_id').value;
            const name = document.getElementById('name').value;
            const plate = document.getElementById('car_plate').value;
            const cardUid = document.getElementById('card_uid').value;

            if(!cardUid) {
                alert("Please place a card on the reader first!");
                return;
            }

            status.style.color = 'blue';
            status.innerText = "⏳ Writing MMU ID to RFID Card...";

            try {
                // 1. Trigger Physical Write 
                await fetch(`http://localhost:4000/write?mmu_id=${mmuId}`);
                
                status.innerText = "💾 Saving to Database...";

                // 2. Save to Database
                const response = await fetch('/api/register', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ mmu_id: mmuId, name: name, car_plate: plate, card_uid: cardUid })
                });

                if(response.ok) {
                    alert("User Registered & Card Written!");
                    location.reload();
                } else {
                    const txt = await response.text();
                    status.style.color = 'red';
                    status.innerText = "Error: " + txt;
                }
            } catch (err) {
                status.style.color = 'red';
                status.innerText = "Error connecting to Reader/Server";
                console.error(err);
            }
        });
    </script>
</body>
</html>